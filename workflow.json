      "id": "19a7d181-d2a8-4dd3-80ce-146f060e27b1",
      "name": "Filter Out Sent/Own Emails"
    },
    {
      "parameters": {
        "jsCode": "const email = $input.first().json;\n\n// With Simplify ON, Gmail returns 'from' as a plain string\n// like \"John Doe <john@example.com>\" or just \"john@example.com\"\nconst rawFrom = email.from || email.payload?.headers?.find(h => h.name === 'From')?.value || '';\n\n// Parse name and email from the from string\nconst fromMatch = rawFrom.match(/^(.*?)\\s*<(.+?)>$/) || rawFrom.match(/^(.+)$/);\nconst fromEmail = fromMatch ? (fromMatch[2] || fromMatch[1] || '').trim() : rawFrom.trim();\nconst fromName = fromMatch && fromMatch[2] ? fromMatch[1].trim() : fromEmail.split('@')[0];\n\nconst subject = email.subject || '(no subject)';\nconst body = email.text || email.snippet || email.body || '';\nconst cleanBody = body.replace(/<[^>]*>/g, '').substring(0, 1500);\n\nreturn [{\n  json: {\n    messageId: email.id || email.messageId || '',\n    from: fromEmail,\n    fromName: fromName || 'Unknown',\n    subject: subject,\n    body: cleanBody,\n    receivedAt: new Date().toISOString(),\n    threadId: email.threadId || email.id || ''\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -336,
        -16
      ],
      "id": "637597dd-8db5-4667-96f2-b7c8ad016a67",
      "name": "Extract & Clean Email Content"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-lite:generateContent?key=AIzaSyClzbg6p18qnHopI55iJ-CXqN-f4o00RGU",
        "sendHeaders": true,
        "specifyHeaders": "json",
        "jsonHeaders": "={\n  \"Content-Type\": \"application/json\"\n}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"contents\": [\n    {\n      \"parts\": [\n        {\n          \"text\": \"You are a support email triage agent. Analyze this email and respond with ONLY valid JSON, no markdown, no code fences.\\n\\nEmail From: {{ $json.fromName }} <{{ $json.from }}>\\nSubject: {{ $json.subject }}\\nBody: {{ $json.body }}\\n\\nRespond with this exact JSON structure:\\n{\\n  \\\"category\\\": \\\"billing|technical|general|spam|refund\\\",\\n  \\\"priority\\\": \\\"high|medium|low\\\",\\n  \\\"confidence\\\": 0.95,\\n  \\\"requires_human\\\": false,\\n  \\\"reason\\\": \\\"one sentence explanation\\\",\\n  \\\"auto_reply\\\": \\\"full reply text if requires_human is false, else null\\\",\\n  \\\"summary\\\": \\\"10 word summary of the issue\\\"\\n}\\n\\nAuto-reply rules:\\n- SET requires_human: false AND write a helpful auto_reply for these: pricing questions, plan information, free tier or free plan questions, business hours, how-to questions, password reset instructions, general product information, feature inquiries.\\n- SET requires_human: true AND set auto_reply to null for these: refund requests, billing disputes, double charges, account access issues, login problems, software bugs, complaints, anything requiring account lookup or payment processing.\\n\\nFor pricing or free plan questions use this auto_reply template:\\n\\\"Hi [fromName],\\\\n\\\\nThank you for your interest! We offer flexible pricing plans to suit different needs. Please visit our website for current pricing details, or reply to this email and our team will provide you with a personalized quote.\\\\n\\\\nBest regards,\\\\nSupport Team\\\"\\n\\nFor password reset use this auto_reply template:\\n\\\"Hi [fromName],\\\\n\\\\nTo reset your password, please click the Forgot Password link on the login page and follow the instructions sent to your registered email.\\\\n\\\\nBest regards,\\\\nSupport Team\\\"\\n\\nIMPORTANT: Replace [fromName] with the actual name from the email. Always return valid JSON only.\"\n        }\n      ]\n    }\n  ],\n  \"generationConfig\": {\n    \"temperature\": 0.1,\n    \"maxOutputTokens\": 800,\n    \"responseMimeType\": \"application/json\"\n  }\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        -96,
        -16
      ],
      "id": "ee21413e-5106-40af-a0b4-b0143ca584bc",
      "name": "AI Classification & Draft Response"
    },
    {
      "parameters": {
        "jsCode": "const aiResponse = $input.first().json;\n\n// Gemini response path is different from Anthropic\nconst rawText = aiResponse.candidates[0].content.parts[0].text;\n\n// Strip markdown code fences if present\nconst clean = rawText.replace(/```json\\n?|\\n?```/g, '').trim();\n\nlet parsed;\ntry {\n  parsed = JSON.parse(clean);\n} catch(e) {\n  parsed = {\n    category: 'general',\n    priority: 'medium',\n    confidence: 0.5,\n    requires_human: true,\n    reason: 'Parse error - defaulting to human review',\n    auto_reply: null,\n    summary: 'Unable to classify'\n  };\n}\n\n// Merge with original email data\nconst email = $('Extract & Clean Email Content').first().json;\n\nreturn [{\n  json: {\n    ...email,\n    ...parsed\n  }\n}];"
      },
